# K Termux 24/7 Ultimate configuration
# Copy this file to .env and adjust values. Do NOT commit real secrets.

# Server bind address. Keep 127.0.0.1 unless you use a secure tunnel/VPN.
KTERMUX_HOST=127.0.0.1
KTERMUX_PORT=7777

# Data directory (SQLite DB, logs, backups live here)
KTERMUX_DATA_DIR=./data

# Admin bootstrap credentials. If empty on first run, the installer asks you to
# choose a username and password interactively (or generates a random password
# when run non-interactively, saved to data/credentials.txt).
KTERMUX_ADMIN_USERNAME=
KTERMUX_ADMIN_PASSWORD=

# Session lifetime in days
KTERMUX_SESSION_TTL_DAYS=7

# External connectivity check endpoint (should return 204/200 quickly)
KTERMUX_NET_ENDPOINT=https://connectivitycheck.gstatic.com/generate_204

# Discord webhook URL for notifications (optional). Stored in DB settings,
# never printed in logs. Leave empty here.
KTERMUX_DISCORD_WEBHOOK=
